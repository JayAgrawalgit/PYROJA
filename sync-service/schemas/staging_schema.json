{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FoxProOrderImportStagingPayload",
  "description": "Schema for staging JSON payload exported by Windows Sync Service for ingestion by native FoxPro IMPORT.PRG",
  "type": "object",
  "required": [
    "version",
    "exported_at",
    "environment",
    "series",
    "orders"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when batch was exported"
    },
    "environment": {
      "type": "string",
      "description": "Target FoxPro financial year directory code (e.g. D2627)",
      "default": "D2627"
    },
    "series": {
      "type": "string",
      "description": "Bill book series identifier",
      "default": "E"
    },
    "default_user": {
      "type": "string",
      "description": "Default operator username in FoxPro",
      "default": "RAM"
    },
    "default_salesman": {
      "type": "string",
      "description": "Default salesman code",
      "default": "SELF"
    },
    "orders": {
      "type": "array",
      "description": "List of validated orders to be converted into invoices",
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "draft_id",
          "customer_code",
          "customer_name",
          "order_date",
          "series",
          "gross_amount",
          "add_amount",
          "less_amount",
          "round_off",
          "net_amount",
          "user",
          "salesman",
          "note",
          "items"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Internal UUID of order in SQLite sync store"
          },
          "draft_id": {
            "type": "string",
            "description": "Unique tablet draft identifier (e.g. TAB01-1048)"
          },
          "tablet_id": {
            "type": "string",
            "description": "Tablet device identifier that originated the draft"
          },
          "customer_code": {
            "type": "string",
            "minLength": 5,
            "maxLength": 5,
            "pattern": "^[0-9]{5}$",
            "description": "5-digit FoxPro customer account code from NAMEMST.CODE"
          },
          "customer_name": {
            "type": "string",
            "maxLength": 40,
            "description": "Denormalized customer trade/legal name for SALEMST.PNAME"
          },
          "order_date": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "description": "Invoice transaction date in YYYYMMDD format for FoxPro DATE field"
          },
          "area_code": {
            "type": "string",
            "maxLength": 5,
            "description": "Customer area code from NAMEMST.ACODE for line items denormalization"
          },
          "series": {
            "type": "string",
            "maxLength": 2,
            "default": "E",
            "description": "Bill book series ('E ' for Estimate)"
          },
          "gross_amount": {
            "type": "number",
            "minimum": 0,
            "description": "Taxable gross subtotal (SALEMST.T4A = SUM(SALETRN.GAMT))"
          },
          "add_amount": {
            "type": "number",
            "default": 0.0,
            "description": "Additional freight / packaging charges (SALEMST.ADD)"
          },
          "less_amount": {
            "type": "number",
            "default": 0.0,
            "description": "Overall bill discount amount (SALEMST.LESS)"
          },
          "round_off": {
            "type": "number",
            "minimum": -1.0,
            "maximum": 1.0,
            "default": 0.0,
            "description": "Round-off adjustment amount (SALEMST.ROFF)"
          },
          "net_amount": {
            "type": "number",
            "minimum": 0,
            "description": "Net invoice grand total (SALEMST.NAMT = T4A + ADD - LESS + ROFF)"
          },
          "user": {
            "type": "string",
            "maxLength": 10,
            "default": "RAM",
            "description": "Operator username (SALEMST.USER / SALETRN.USER)"
          },
          "salesman": {
            "type": "string",
            "maxLength": 5,
            "default": "SELF",
            "description": "Salesman code (SALEMST.SCODE / SALETRN.SCODE)"
          },
          "note": {
            "type": "string",
            "maxLength": 40,
            "description": "Traceability note stored in SALEMST.NOTE (e.g. 'DRAFT:TAB01-1048')"
          },
          "remarks": {
            "type": "string",
            "maxLength": 50,
            "description": "Optional customer order remarks split into SALEMST.REMA and REML"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "description": "Line items for the invoice (SALETRN.DBF)",
            "items": {
              "type": "object",
              "required": [
                "line_no",
                "item_code",
                "item_name",
                "group_code",
                "company_code",
                "unit",
                "rate_type",
                "quantity",
                "rate",
                "gross_amount",
                "tax_code",
                "tax_percent",
                "taxable_amount",
                "tax_amount",
                "net_amount"
              ],
              "properties": {
                "line_no": {
                  "type": "integer",
                  "minimum": 1
                },
                "item_code": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 5,
                  "description": "5-character FoxPro product code from ITEMMST.CODE"
                },
                "item_name": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "Product title from ITEMMST.NAME"
                },
                "group_code": {
                  "type": "string",
                  "maxLength": 5,
                  "description": "Product group classification from ITEMMST.GCODE (e.g. 'MIX')"
                },
                "company_code": {
                  "type": "string",
                  "maxLength": 5,
                  "description": "Manufacturer/brand code from ITEMMST.CCODE (e.g. '50')"
                },
                "unit": {
                  "type": "string",
                  "maxLength": 5,
                  "description": "Unit of measurement from ITEMMST.PACK (e.g. 'BOX', 'PKT')"
                },
                "rate_type": {
                  "type": "string",
                  "maxLength": 1,
                  "default": "P",
                  "description": "Rate type indicator from ITEMMST.RTTP ('P' = Per Piece/Pack)"
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Quantity sold (SALETRN.QTY). Must be integer multiple of QIB."
                },
                "rate": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Unit price (SALETRN.RATE)"
                },
                "gross_amount": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Line gross total: quantity * rate (SALETRN.GAMT)"
                },
                "tax_code": {
                  "type": "string",
                  "maxLength": 5,
                  "default": "CST",
                  "description": "Tax classification code from ITEMMST.TCODE (SALETRN.TCODE)"
                },
                "tax_percent": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.0,
                  "description": "Tax percentage rate from ITEMMST.TAX"
                },
                "taxable_amount": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Taxable amount after line discounts (SALETRN.TAMT)"
                },
                "tax_amount": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.0,
                  "description": "Calculated tax amount (SALETRN.TAXA)"
                },
                "net_amount": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Line net total: taxable_amount + tax_amount (SALETRN.NAMT)"
                }
              }
            }
          }
        }
      }
    }
  }
}
