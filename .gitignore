# ==========================================
# macOS & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ==========================================
# IDE & Editor Configs
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~

# ==========================================
# Python (sync-service)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
sync-service/.venv/
sync-service/__pycache__/
sync-service/tests/__pycache__/
sync-service/*.log
*.log

# SQLite runtime DBs and WAL journals
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db-wal
*.db-shm

# ==========================================
# Node.js & Web Assets (tablet-app)
# ==========================================
node_modules/
tablet-app/node_modules/
tablet-app/www/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Android Build Outputs & Caches
# ==========================================
.gradle/
**/build/
tablet-app/android/.gradle/
tablet-app/android/build/
tablet-app/android/app/build/
tablet-app/android/capacitor-cordova-android-plugins/build/
**/local.properties
*.iml

# Capacitor copied web assets (generated by npx cap sync)
tablet-app/android/app/src/main/assets/public/
tablet-app/android/app/src/main/assets/capacitor.config.json
tablet-app/android/app/src/main/assets/capacitor.plugins.json

# Build outputs (allow distribution APK, ignore root dist, release, and zip packages)
*.apk
*.aab
/dist/
/release/
*.zip

# ==========================================
# FoxPro Temporary Files
# ==========================================
*.TMP
*.tmp

# ==========================================
# Runtime Order Staging & Import Outputs
